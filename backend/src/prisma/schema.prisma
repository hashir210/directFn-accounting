// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String            @id @default(cuid())
  name            String
  ownerId         String
  owner           User              @relation("OrgOwner", fields: [ownerId], references: [id])
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  status          String            @default("active")
  isPlatform      Boolean           @default(false)
  disabledScreens String?           @db.Text
  contactEmail    String?
  gstVatNumber    String?
  address         String?
  fiscalYear      String?           @default("jan-dec")
  currency        String?           @default("USD")
  timeZone        String?           @default("UTC-5")
  logoUrl         String?
  maxUsers        Int               @default(5)
  revenueTarget   Decimal?          @db.Decimal(15, 2)
  expenseBudget   Decimal?          @db.Decimal(15, 2)
  profitGoal      Decimal?          @db.Decimal(15, 2)
  createdAt       DateTime          @default(now())

  users          User[]           @relation("OrgUsers")
  roles          Role[]
  customers      Customer[]
  suppliers      Supplier[]
  invoices       Invoice[]
  expenses       Expense[]
  incomes        Income[]
  accounts       Account[]
  journalEntries JournalEntry[]
  products       Product[]
  stockMovements StockMovement[]
  warehouses     Warehouse[]
  purchaseBills  PurchaseBill[]
  bankAccounts   BankAccount[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  payments       Payment[]

  SalesOrder     SalesOrder[]
  SalesInvoice   SalesInvoice[]
  SalesReturn    SalesReturn[]
  Coupon         Coupon[]
  Discount       Discount[]
  PurchaseOrder  PurchaseOrder[]
  GoodsReceived  GoodsReceived[]
  SupplierReturn SupplierReturn[]
  taxes          Tax[]
  categories     Category[]
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isSystemRole   Boolean      @default(false)
  createdAt      DateTime     @default(now())

  users           User[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation("OrgUsers", fields: [organizationId], references: [id])
  roleId         String?
  role           Role?          @relation(fields: [roleId], references: [id])
  ownedOrgs      Organization[] @relation("OrgOwner")

  email            String
  password         String
  name             String?
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  screenBlocks            UserScreenBlock[]

  @@unique([organizationId, email])
  @@index([roleId])
}

model UserScreenBlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenKey String
  createdAt DateTime @default(now())

  @@unique([userId, screenKey])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// --- Dashboard Domain Models ---

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  address        String?
  creditLimit    Decimal      @db.Decimal(12, 2)
  status         String       @default("Active") // 'Active', 'Inactive'
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoices     Invoice[]
  salesOrders  SalesOrder[]
  couponUsages CouponUsage[]

  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceNo      String
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(12, 2)
  subTotal       Decimal      @default(0.00) @db.Decimal(12, 2)
  taxTotal       Decimal      @default(0.00) @db.Decimal(12, 2)
  discountTotal  Decimal      @default(0.00) @db.Decimal(12, 2)
  notes          String?      @db.Text
  terms          String?      @db.Text
  status         String       @default("pending")
  issuedAt       DateTime     @default(now())
  dueAt          DateTime
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments Payment[]
  items    InvoiceItem[]

  @@unique([organizationId, invoiceNo])
  @@index([organizationId, status, paidAt])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(0.00) @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0.00) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       String?
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  description    String?
  amount         Decimal      @db.Decimal(12, 2)
  date           DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, date])
}

model Income {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       String?
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  description    String?
  amount         Decimal      @db.Decimal(12, 2)
  date           DateTime
  referenceNo    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, date])
}

// ===================================================================
// ACCOUNTING MODULE
// ===================================================================

model Account {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  type           String // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  parentId       String?
  parent         Account?     @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Account[]    @relation("AccountHierarchy")
  isActive       Boolean      @default(true)
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  journalLines JournalLine[]
  Expense      Expense[]
  Income       Income[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model JournalEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entryNo        String
  date           DateTime
  description    String?
  status         String       @default("draft") // draft, posted
  referenceType  String?
  referenceId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines JournalLine[]

  @@unique([organizationId, entryNo])
  @@index([organizationId, date, status])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal      @default(0.00) @db.Decimal(12, 2)
  credit         Decimal      @default(0.00) @db.Decimal(12, 2)
  memo           String?
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

model Product {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  sku               String
  barcode           String?
  category          String?
  unit              String       @default("Unit")
  imageUrl          String?
  stockQuantity     Int          @default(0)
  lowStockThreshold Int          @default(10)
  purchasePrice     Decimal      @default(0.00) @db.Decimal(10, 2)
  sellingPrice      Decimal      @db.Decimal(10, 2)
  taxRate           Decimal      @default(0.00) @db.Decimal(5, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  stockMovements     StockMovement[]
  invoiceItems       InvoiceItem[]
  SalesOrderItem     SalesOrderItem[]
  SalesInvoiceItem   SalesInvoiceItem[]
  SalesReturnItem    SalesReturnItem[]
  PurchaseOrderItem  PurchaseOrderItem[]
  GoodsReceivedItem  GoodsReceivedItem[]
  SupplierReturnItem SupplierReturnItem[]

  @@unique([organizationId, sku])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  contactEmail   String?
  phone          String?
  category       String?
  paymentTerms   String       @default("Net 30")
  status         String       @default("Active") // 'Active', 'Inactive'
  dueAmount      Decimal      @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseBills   PurchaseBill[]
  payments        SupplierPayment[]
  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model PurchaseBill {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  billNo          String
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  amount          Decimal        @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0.00) @db.Decimal(12, 2)
  status          String         @default("Unpaid")
  dueDate         DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments Payment[]

  @@unique([organizationId, billNo])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now())
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String?
  address        String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockMovements StockMovement[]

  @@unique([organizationId, name])
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String // 'Stock In', 'Stock Out', 'Transfer', 'Damaged', 'Adjustment'
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku            String
  itemName       String
  quantity       Int
  warehouse      String       @default("Main Warehouse")
  warehouseId    String?
  warehouseRef   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  status         String       @default("Completed")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model BankAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  accountNumber  String       @unique
  bankName       String
  balance        Decimal      @default(0) @db.Decimal(14, 2)
  currency       String       @default("USD")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments Payment[]

  @@index([organizationId, isActive])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  type           String       @default("info")
  read           Boolean      @default(false)
  referenceType  String?
  referenceId    String?
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  entity         String // e.g. "INVOICE", "USER", "STOCK"
  entityId       String? // the ID of the affected record
  details        String? // JSON stringified details
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations Organization[]
  features      PlanFeature[]
}

model PlanFeature {
  id         String           @id @default(cuid())
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  createdAt  DateTime         @default(now())

  @@unique([planId, featureKey])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  amount Decimal @db.Decimal(12, 2)
  method String // 'Cash', 'Bank', 'Card', 'Online'
  type   String // 'Inbound', 'Outbound'
  status String  @default("Completed") // 'Completed', 'Pending', 'Failed'

  referenceType String? // 'Invoice', 'PurchaseBill', 'Manual'
  referenceId   String? // ID of Invoice or PurchaseBill
  invoice       Invoice?      @relation(fields: [referenceId], references: [id], map: "Payment_InvoiceId_fkey")
  purchaseBill  PurchaseBill? @relation(fields: [referenceId], references: [id], map: "Payment_PurchaseBillId_fkey")

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([bankAccountId])
}

// ===================================================================
// RESTORED PHASES 9 & 10 MODELS
// ===================================================================

model SalesOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderNo        String
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal       Decimal      @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal      @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  status         String       @default("Pending")
  notes          String?
  couponId       String?
  coupon         Coupon?      @relation(fields: [couponId], references: [id])
  discountId     String?
  discount       Discount?    @relation(fields: [discountId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items         SalesOrderItem[]
  salesInvoices SalesInvoice[]

  @@unique([organizationId, orderNo])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  discount     Decimal    @default(0.00) @db.Decimal(12, 2)
  taxRate      Decimal    @default(0.00) @db.Decimal(5, 2)
  lineTotal    Decimal    @db.Decimal(12, 2)
}

model SalesInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceNo      String
  salesOrderId   String
  salesOrder     SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  subtotal       Decimal      @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal      @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  dueAt          DateTime
  status         String       @default("Unpaid")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items        SalesInvoiceItem[]
  salesReturns SalesReturn[]

  @@unique([organizationId, invoiceNo])
}

model SalesInvoiceItem {
  id             String       @id @default(cuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  receivedQty    Int          @default(0)
  unitPrice      Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0.00) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0.00) @db.Decimal(5, 2)
  lineTotal      Decimal      @db.Decimal(12, 2)
}

model SalesReturn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  returnNo       String
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  totalAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  reason         String?
  status         String       @default("Pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items SalesReturnItem[]

  @@unique([organizationId, returnNo])
}

model SalesReturnItem {
  id            String      @id @default(cuid())
  salesReturnId String
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  unitPrice     Decimal     @db.Decimal(12, 2)
  lineTotal     Decimal     @db.Decimal(12, 2)
  reason        String?
}

model Coupon {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  startDate      DateTime?
  endDate        DateTime?
  usageLimit     Int?
  usedCount      Int          @default(0)
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  discountType   String
  discountValue  Decimal      @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  salesOrders SalesOrder[]
  usages      CouponUsage[]

  @@unique([organizationId, code])
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  usedAt     DateTime @default(now())
}

model Discount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  startDate      DateTime?
  endDate        DateTime?
  type           String
  value          Decimal      @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  salesOrders SalesOrder[]

  @@unique([organizationId, name])
}

model PurchaseOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderNo        String
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  subtotal       Decimal      @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal      @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  status         String       @default("Pending")
  expectedDate   DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items           PurchaseOrderItem[]
  goodsReceived   GoodsReceived[]
  purchaseBills   PurchaseBill[]
  supplierReturns SupplierReturn[]

  @@unique([organizationId, orderNo])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(0.00) @db.Decimal(5, 2)
  lineTotal       Decimal       @db.Decimal(12, 2)
}

model GoodsReceived {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  grnNo           String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  status          String        @default("Received")
  receivedDate    DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  items GoodsReceivedItem[]

  @@unique([organizationId, grnNo])
}

model GoodsReceivedItem {
  id              String        @id @default(cuid())
  goodsReceivedId String
  goodsReceived   GoodsReceived @relation(fields: [goodsReceivedId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderedQty      Int
  receivedQty     Int
  acceptedQty     Int           @default(0)
  rejectedQty     Int           @default(0)
}

model SupplierReturn {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  returnNo        String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  totalAmount     Decimal        @default(0.00) @db.Decimal(12, 2)
  reason          String?
  status          String         @default("Pending")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items SupplierReturnItem[]

  @@unique([organizationId, returnNo])
}

model SupplierReturnItem {
  id               String         @id @default(cuid())
  supplierReturnId String
  supplierReturn   SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(12, 2)
  reason           String?
}

model Tax {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  rate           Decimal      @db.Decimal(5, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String       // 'PRODUCT', 'EXPENSE', 'INCOME', 'SUPPLIER'
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name, type])
}
